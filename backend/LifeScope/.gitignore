# ===== IDE (STS / Eclipse / IntelliJ / VS Code) =====
.idea/
.vscode/
*.iml
*.ipr
*.iws
.settings/
.project
.classpath
.metadata/
.apt_generated
.factorypath
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# ===== OS =====
.DS_Store
Thumbs.db

# ===== 빌드 / 산출물 (Gradle / Maven) =====
build/
dist/
out/
target/
.gradle/
!gradle/wrapper/gradle-wrapper.jar
# gradle wrapper 는 CI/신규 개발자 환경 구성이므로 반드시 추적한다
!gradle/wrapper/gradle-wrapper.properties
.mvn/
*.class
*.jar
*.war
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/

# ===== NetBeans (참조용 정리) =====
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ===== 로컬 설정 / 환경 변수 / 보안 키 =====
*.yml
*.local.yml
*.properties
*.local.conf
application-secret.yml
application-secrets.yml
.env
.env.*
# gradle wrapper 는 빌드 구성이라 예외 처리 (위 *.properties 규칙에 걸리지 않도록)
!gradle/wrapper/gradle-wrapper.properties
# 값이 없는 템플릿은 공유해야 하므로 예외 처리
!.env.example
ssh-key-2026-08-25.key

# ===== 테스트 / 리포트 =====
*.html
!**/src/main/resources/templates/**/*.html
!**/src/main/resources/static/**/*.html

# ===== Docker =====
.docker/

# ===== 로그 =====
*.log
logs/

# ===== 임시 / 캐시 =====
*.tmp
*.temp
.cache/